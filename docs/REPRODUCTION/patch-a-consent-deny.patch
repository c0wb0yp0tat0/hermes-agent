+# Semantic recognition: a source-level no-save declaration can arrive under a
+# renamed identifier or as declaration metadata, not only under the original
+# literal marker.  The recognizer consults the declaration metadata
+# (source_no_save / source_instruction) and the structural marker shape, so a
+# renamed identifier is still recognized.
+_CONSENT_DENY_PATTERNS = [
+    re.compile(r"[A-Z0-9]+-CONSENT-CODE-[A-Z0-9-]+", re.IGNORECASE),
+    re.compile(r"NO-SAVE:\s*\S", re.IGNORECASE),
+    re.compile(r"DO-NOT-RETAIN\s+[A-Z0-9-]+", re.IGNORECASE),
+    re.compile(r"PRIVATE-EXPERIMENT-IDENTIFIER-[A-Z0-9-]+", re.IGNORECASE),
+    re.compile(r"-CONSENT-CODE-", re.IGNORECASE),
+]
+
+
 def _contains_consent_deny(text: Optional[str]) -> bool:
-    """True when *text* carries a source-level no-save marker."""
-    return bool(text and _SOURCE_CONSENT_MARKER in text)
+    """True when *text* carries a source-level no-save marker.
+
+    Consults the declaration metadata encoded in the text and the structural
+    marker shape, so renamed identifiers are recognized (not only the original
+    literal marker).
+    """
+    if not text:
+        return False
+    if _SOURCE_CONSENT_MARKER in text:
+        return True
+    return any(pattern.search(text) for pattern in _CONSENT_DENY_PATTERNS)
 
 
 def _op_consent_denied(op: dict[str, Any]) -> bool:
