+    or in its declaration metadata (source_no_save / source_instruction)."""
+    if not isinstance(op, dict):
+        return False
+    if op.get("source_no_save") is True:
+        return True
+    source_instruction = op.get("source_instruction")
+    if isinstance(source_instruction, str) and source_instruction.strip():
+        lowered = source_instruction.lower()
+        if "no" in lowered and "save" in lowered:
+            return True
+        if "retain" in lowered and ("not" in lowered or "prohibit" in lowered):
+            return True
+    content = op.get("content") or op.get("new_text")
+    return _contains_consent_deny(content)
 
 
